{
  "name": "@stantonfoundation/brand",
  "type": "module",
  "version": "1.0.0",
  "description": "Stanton College Preparatory Foundation design system: tokens, stylesheet, logo files and guidelines.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stantonfoundation/brand.git"
  },
  "files": [
    "css/",
    "tokens/",
    "assets/",
    "!assets/logo/source/"
  ],
  "exports": {
    "./scpf.css": "./css/scpf.css",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./assets/*": "./assets/*"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "prettier --check . && markdownlint-cli2",
    "format": "prettier --write .",
    "test": "node scripts/check-tokens.mjs && node scripts/check-contrast.mjs",
    "check:links": "lychee --config lychee.toml \"**/*.md\" \"**/*.html\"",
    "contrast": "node scripts/check-contrast.mjs --write && prettier --write guidelines/color.md",
    "build:pages": "node scripts/build-pages.mjs",
    "build:kit": "node scripts/build-kit.mjs"
  },
  "devDependencies": {
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10"
  }
}
