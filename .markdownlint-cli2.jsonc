{
  // One paragraph per line; Prettier owns table formatting.
  "config": {
    "MD013": false,
    "MD060": false,
  },
  "globs": ["**/*.md"],
  // handoff/ stays verbatim. CLAUDE.md is a single @AGENTS.md import.
  "ignores": [
    "handoff/**",
    "node_modules/**",
    "_site/**",
    "_kit/**",
    "CLAUDE.md",
  ],
}
