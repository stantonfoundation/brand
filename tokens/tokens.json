{
  "$description": "Stanton College Preparatory Foundation design tokens. W3C Design Tokens format. tokens/tokens.css mirrors this file; scripts/check-tokens.mjs fails if they drift.",
  "color": {
    "$type": "color",
    "midnight": {
      "$value": "#0F172B",
      "$description": "Hero fields, footer, header, text on gold"
    },
    "navy": {
      "$value": "#16213C",
      "$description": "Core brand: headings, default text, navy buttons, card flags"
    },
    "devil-blue": {
      "$value": "#274270",
      "$description": "Links, secondary actions, active and focus states"
    },
    "gold": {
      "$value": "#B4883C",
      "$description": "Giving actions only. Keep scarce"
    },
    "gold-dark": {
      "$value": "#9C7330",
      "$description": "Gold hover on light surfaces"
    },
    "gold-light": {
      "$value": "#C79A4C",
      "$description": "Gold hover on dark surfaces"
    },
    "slate": { "$value": "#4A5567", "$description": "Body copy" },
    "steel": {
      "$value": "#5E6A80",
      "$description": "Labels, meta, serial numbers. 4.5:1 or better on white, paper and parchment"
    },
    "silver": {
      "$value": "#C6CBD3",
      "$description": "Body text on navy and midnight, input borders"
    },
    "platinum": {
      "$value": "#E2E4E8",
      "$description": "Borders, hairline rules"
    },
    "paper": { "$value": "#F8F8F6", "$description": "Page ground" },
    "parchment": {
      "$value": "#F3EADA",
      "$description": "Gold-tinted fills, selected gift amount"
    },
    "parchment-rule": {
      "$value": "#E4D3B0",
      "$description": "Border on parchment cards"
    },
    "navy-card": {
      "$value": "#1D2A48",
      "$description": "Card fill on navy and midnight"
    },
    "steel-dark": {
      "$value": "#8E9AB0",
      "$description": "Muted text on dark surfaces"
    },
    "white": {
      "$value": "#FFFFFF",
      "$description": "Cards, inputs, headings on dark"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "serif": {
        "$value": ["Newsreader", "Georgia", "serif"],
        "$description": "Display and headings. Weights 300-600, italic 400"
      },
      "sans": {
        "$value": ["Instrument Sans", "system-ui", "sans-serif"],
        "$description": "Body, UI, labels. Weights 400-600"
      }
    },
    "size": {
      "$type": "dimension",
      "display": {
        "$value": "62px",
        "$description": "Hero headline. 44px below 960px"
      },
      "h1": {
        "$value": "40px",
        "$description": "Section headings (h2, .h1). 32px below 960px"
      },
      "h2": {
        "$value": "26px",
        "$description": "Card and sub-section headings (h3, .h2)"
      },
      "h3": { "$value": "21px", "$description": "Sans heading (.h3)" },
      "stat": { "$value": "52px", "$description": "Impact numbers" },
      "lead": { "$value": "20px", "$description": "Intro paragraphs" },
      "body": { "$value": "15.5px", "$description": "Paragraphs and buttons" },
      "input": {
        "$value": "16px",
        "$description": "Form controls. 16px stops iOS zoom on focus"
      },
      "label": { "$value": "12.5px", "$description": "Uppercase labels" },
      "eyebrow": {
        "$value": "11.5px",
        "$description": "Uppercase eyebrow over headings"
      }
    }
  },
  "space": {
    "$type": "dimension",
    "gutter": { "$value": "6vw", "$description": "Horizontal page padding" },
    "max-width": {
      "$value": "1440px",
      "$description": "Widest content measure"
    },
    "section": {
      "$value": "84px",
      "$description": "Vertical padding of a section"
    },
    "section-head": {
      "$value": "44px",
      "$description": "Gap below a section head"
    },
    "grid-2": { "$value": "56px", "$description": "Gap in two-column layouts" },
    "grid-3": {
      "$value": "28px",
      "$description": "Gap in three-column card grids"
    },
    "grid-4": {
      "$value": "44px",
      "$description": "Gap in four-column stat rows"
    },
    "tap-target": {
      "$value": "48px",
      "$description": "Minimum height of buttons and inputs. Header controls go to 44px"
    }
  },
  "border": {
    "$type": "dimension",
    "radius": { "$value": "0px", "$description": "Squared corners everywhere" },
    "hairline": {
      "$value": "1px",
      "$description": "Rules, card and input borders"
    },
    "flag": {
      "$value": "3px",
      "$description": "Navy top rule on flagged cards"
    },
    "focus": { "$value": "2px", "$description": "Focus ring, offset 2px" }
  }
}
